{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gidp/profiles/manifest.schema.json",
  "title": "GIDP Profile Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "profile",
    "attributes",
    "qualification"
  ],
  "properties": {
    "manifest": {
      "const": "gidp-profile/0.1"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "wire",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "wire": {
          "const": "gidp/0.1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "type",
          "operators"
        ],
        "properties": {
          "subject": {
            "enum": [
              "fact",
              "preference",
              "requirement",
              "side_dependent"
            ]
          },
          "subject_note": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "money",
              "enum",
              "set",
              "range"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "bounds_exclusive": {
            "type": "boolean"
          },
          "general_value_means": {
            "enum": [
              "approximate_knowledge",
              "accepted_set"
            ]
          },
          "operators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "absent_means": {
            "enum": [
              "unknown",
              "declined"
            ]
          },
          "identifying": {
            "type": "boolean"
          },
          "retrieval": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_dimensions",
        "opportunity_meaning"
      ],
      "properties": {
        "required_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "joint_predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "over",
              "semantics",
              "computable_from",
              "wire"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "over": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "semantics": {
                "type": "string",
                "minLength": 1
              },
              "computable_from": {
                "enum": [
                  "exchanged_claims",
                  "private_evaluation"
                ]
              },
              "wire": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "operator",
                  "value",
                  "satisfied_when"
                ],
                "description": "How the predicate travels: as claims on `key` with `operator`. `point`: the claim names one candidate value, and the responder answers whether it satisfies its private value. `satisfied_when`: `both_directions` -- each side answered compatible to the same value; `one_direction` -- one compatible answer suffices.",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "enum": [
                      "point",
                      "range"
                    ]
                  },
                  "satisfied_when": {
                    "enum": [
                      "both_directions",
                      "one_direction"
                    ]
                  }
                }
              }
            }
          }
        },
        "opportunity_meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "granularity": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_bucket_width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "bits_per_attribute": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "scope": {
          "const": "per_standing_interest"
        },
        "domain": {
          "type": "object",
          "description": "Per budgeted attribute, the finite public hypothesis space: the lattice cells between min and max. Without it no posterior can be computed.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "prior": {
          "const": "uniform",
          "description": "The prior over the domain's cells. Only uniform is defined by this format version."
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intended_use": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
