{
  "scenario": "never-leaves-no-trace",
  "notes": "A claim on a `never` attribute is declined rather than evaluated, and a `never` dependency produces no contingency marker at all, since a flag that exists only because of it would be a transmitted result produced from it (10.3).",
  "spec": [
    "10.3",
    "14.6",
    "15.5"
  ],
  "setup": {
    "A": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true,
        "PUBLISH_PROJECTION": true,
        "NEGOTIATE_NONBINDING": true
      }
    },
    "B": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value",
        "toxic_secret": "radioactive"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session",
        "toxic_secret": "never"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true,
        "PUBLISH_PROJECTION": true,
        "NEGOTIATE_NONBINDING": true
      },
      "conditional_on": [
        "board_vote"
      ],
      "conditional_on_policy": "never"
    }
  },
  "steps": [
    {
      "open": {
        "purpose": "test"
      }
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c1",
            "key": "toxic_secret",
            "operator": "equals",
            "value": "radioactive"
          }
        ]
      },
      "expect_results": [
        {
          "claim_id": "c1",
          "result": "declined"
        }
      ],
      "forbid_substrings": [
        "radioactive"
      ]
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c2",
            "key": "domain",
            "operator": "intersects",
            "value": [
              "enterprise_software"
            ],
            "supersedes": [
              "c1"
            ]
          }
        ]
      },
      "expect_results": [
        {
          "claim_id": "c2",
          "result": "compatible"
        }
      ]
    },
    {
      "qualify": {
        "role": "B",
        "expect": true
      }
    },
    {
      "qualify": {
        "role": "A",
        "expect": true
      }
    },
    {
      "opportunity": {
        "role": "A",
        "expect_contingent_on": [],
        "forbid_substrings": [
          "board_vote",
          "radioactive"
        ]
      }
    }
  ]
}
