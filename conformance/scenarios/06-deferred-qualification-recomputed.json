{
  "scenario": "deferred-qualification-recomputed",
  "notes": "The reviewer's four-step sequence (S-47): a qualifying result arrives while a disclosure is pending (step 2), a further claim resolves unknown during the same wait (step 3); at the return to PROBING (step 4) the entry conditions are recomputed over the propositions then standing, so the session does NOT qualify. Nothing qualifying is remembered from mid-wait.",
  "spec": [
    "15.2",
    "17.2"
  ],
  "setup": {
    "A": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true,
        "PUBLISH_PROJECTION": true,
        "NEGOTIATE_NONBINDING": true
      }
    },
    "B": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true,
        "PUBLISH_PROJECTION": true,
        "NEGOTIATE_NONBINDING": true
      }
    }
  },
  "steps": [
    {
      "open": {
