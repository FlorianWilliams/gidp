        "claims": [
          {
            "claim_id": "c1",
            "key": "domain",
            "operator": "intersects",
            "value": [
              "enterprise_software"
            ]
          }
        ]
      },
      "expect_results": [
        {
          "claim_id": "c1",
          "result": "compatible"
        }
