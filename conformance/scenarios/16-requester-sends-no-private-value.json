{
  "scenario": "requester-sends-no-private-value",
  "notes": "A request MUST NOT contain the requester's own private values (14.3), the reserved dependency lists of 19.1 included. The sender's own implementation refuses to emit a claim that names its private value, an element of it, or a range collapsed onto it; a hypothesis it does not hold travels normally. Found by the first independent implementation (E-01).",
  "spec": [
    "14.3",
    "19.1"
  ],
  "setup": {
    "A": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "ceiling": 80
      },
      "policy": {
        "domain": "discovery",
        "ceiling": "evaluation_only"
      },
      "conditional_on": [
        "anchor_commitment"
      ],
      "conditional_on_policy": "evaluation_only",
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true
      }
    },
    "B": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "ceiling": 90
      },
      "policy": {
        "domain": "discovery"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true
      }
    }
  },
  "steps": [
    {
      "open": {
        "purpose": "test"
      }
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c1",
            "key": "ceiling",
            "operator": "equals",
            "value": 80
          }
        ]
      },
      "expect_error": true
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c2",
            "key": "ceiling",
            "operator": "overlaps",
            "value": {
              "min": 80,
              "max": 80
            }
          }
        ]
      },
      "expect_error": true
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c3",
            "key": "conditional_on",
            "operator": "intersects",
            "value": [
              "anchor_commitment"
            ]
          }
        ]
      },
      "expect_error": true
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c4",
            "key": "ceiling",
            "operator": "overlaps",
            "value": {
              "min": 60,
              "max": 100
            }
          }
        ]
      }
    }
  ]
}
