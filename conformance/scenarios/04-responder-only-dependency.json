{
  "scenario": "responder-only-dependency",
  "notes": "A dependency known only to the responder, protected evaluation_only, must still mark the Opportunity as contingent -- as the token `undisclosed`, never by name. The responder states it in its CompatibilityResponse (14.3); the initiator merges it (14.6).",
  "spec": [
    "10.3",
    "14.3",
    "14.6"
  ],
  "setup": {
    "A": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session"
      },
      "authority": {
        "PROBE": "true",
        "DISCLOSE": "true",
        "INTRODUCE": "true",
        "PUBLISH_PROJECTION": "true",
        "NEGOTIATE_NONBINDING": "true"
      }
    },
    "B": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session"
      },
      "authority": {
        "PROBE": "true",
        "DISCLOSE": "true",
        "INTRODUCE": "true",
        "PUBLISH_PROJECTION": "true",
        "NEGOTIATE_NONBINDING": "true"
      },
      "conditional_on": [
        "anchor_investor_commitment"
      ]
    }
  },
  "steps": [
