{
  "scenario": "cross-direction-requests",
  "notes": "Section 17.2 holds state per side AND per direction of request. A's consent awaits B's Principal (provisional pending_principal_approval); B may meanwhile ask A for a disclosure in the reverse direction, and the Principal's later decision still lands where it was awaited. A single shared wait slot would wrongly refuse the middle step.",
  "spec": [
    "14",
    "14.5",
    "16.1",
    "17.2"
  ],
  "setup": {
    "A": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session"
      },
      "authority": {
        "PROBE": "true",
        "DISCLOSE": "true",
        "INTRODUCE": "true"
      }
    },
    "B": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "open_attribute": "value"
      },
      "policy": {
        "domain": "discovery",
        "open_attribute": "session"
      },
      "authority": {
        "PROBE": "true",
        "DISCLOSE": "true",
        "INTRODUCE": "approval_required"
      }
    }
  },
  "steps": [
    {
      "open": {
        "purpose": "test"
      }
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c1",
            "key": "domain",
            "operator": "intersects",
            "value": [
              "enterprise_software"
            ]
          }
        ]
      },
      "expect_results": [
        {
          "claim_id": "c1",
          "result": "compatible"
        }
      ]
    },
    {
      "qualify": {
        "role": "B",
        "expect": true
      }
    },
    {
      "qualify": {
        "role": "A",
        "expect": true
      }
    },
    {
      "request_consent": {
        "from": "A",
        "action": "reveal_identity",
        "scope": [
          "open_attribute"
        ]
      },
      "expect_consent": "pending_principal_approval"
    },
    {
      "request_disclosure": {
        "from": "B",
        "attribute": "open_attribute",
        "purpose": "meanwhile"
      },
      "expect_disclosure": "granted"
    },
    {
      "principal_answers": {
        "role": "B",
        "granted": true
      }
    },
    {
      "state": {
        "role": "A",
        "expect": "CONSENTED"
      }
    }
  ]
}
