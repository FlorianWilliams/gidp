{
  "scenario": "consent-waives-no-authority",
  "notes": "A granted reveal_identity consent opens a possibility and waives no other row of 16.3. Once B's Principal withdraws INTRODUCE, neither door confirms the identity: a claim on principal_identity is declined, and so is its disclosure (10.6, 16.3). Found by the first independent implementation (E-02).",
  "spec": [
    "10.6",
    "16.1",
    "16.3"
  ],
  "setup": {
    "A": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "principal_identity": "Borealis SA"
      },
      "policy": {
        "domain": "discovery",
        "principal_identity": "session"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true
      }
    },
    "B": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "principal_identity": "Acme GmbH"
      },
      "policy": {
        "domain": "discovery",
        "principal_identity": "session"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true
      }
    }
  },
  "steps": [
    {
      "open": {
        "purpose": "test"
      }
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c1",
            "key": "domain",
            "operator": "intersects",
            "value": [
              "enterprise_software"
            ]
          }
        ]
      },
      "expect_results": [
        {
          "claim_id": "c1",
          "result": "compatible"
        }
      ]
    },
    {
      "qualify": {
        "role": "B",
        "expect": true
      }
    },
    {
      "qualify": {
        "role": "A",
        "expect": true
      }
    },
    {
      "request_consent": {
        "from": "A",
        "action": "reveal_identity",
        "scope": [
          "principal_identity"
        ]
      },
      "expect_consent": "granted"
    },
    {
      "set_authority": {
        "role": "B",
        "level": "INTRODUCE",
        "value": false
      }
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c2",
            "key": "principal_identity",
            "operator": "equals",
            "value": "Acme GmbH"
          }
        ]
      },
      "expect_results": [
        {
          "claim_id": "c2",
          "result": "declined"
        }
      ]
    },
    {
      "request_disclosure": {
        "from": "A",
        "attribute": "principal_identity",
        "purpose": "introduce"
      },
      "expect_disclosure": "declined",
      "forbid_substrings": [
        "Acme"
      ]
    }
  ]
}
