{
  "scenario": "t15",
  "setup": {
    "A": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "principal_identity": "Borealis SA"
      },
      "policy": {
        "domain": "discovery",
        "principal_identity": "session"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true
      }
    },
    "B": {
      "conditions": {
        "domain": [
          "enterprise_software"
        ],
        "principal_identity": "Acme GmbH"
      },
      "policy": {
        "domain": "discovery",
        "principal_identity": "session"
      },
      "authority": {
        "PROBE": true,
        "DISCLOSE": true,
        "INTRODUCE": true
      }
    }
  },
  "steps": [
    {
      "open": {
        "purpose": "test"
      }
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c1",
            "key": "domain",
            "operator": "intersects",
            "value": [
              "enterprise_software"
            ]
          }
        ]
      }
    },
    {
      "qualify": {
        "role": "B"
      }
    },
    {
      "qualify": {
        "role": "A"
      }
    },
    {
      "request_consent": {
        "from": "A",
        "action": "reveal_identity",
        "scope": [
          "principal_identity"
        ]
      }
    },
    {
      "set_authority": {
        "role": "B",
        "level": "INTRODUCE",
        "value": false
      }
    },
    {
      "ask": {
        "from": "A",
        "claims": [
          {
            "claim_id": "c2",
            "key": "principal_identity",
            "operator": "equals",
            "value": "Acme GmbH"
          }
        ]
      }
    },
    {
      "request_disclosure": {
        "from": "A",
        "attribute": "principal_identity",
        "purpose": "introduce"
      }
    }
  ]
}
