{
  "$defs": {
    "Authority": {
      "description": "Authority levels, least to most consequential (Section 16.1).",
      "enum": [
        "OBSERVE",
        "SEARCH",
        "PUBLISH_PROJECTION",
        "PROBE",
        "DISCLOSE",
        "INTRODUCE",
        "NEGOTIATE_NONBINDING",
        "COMMIT"
      ],
      "title": "Authority",
      "type": "string"
    },
    "HandoffKind": {
      "enum": [
        "human",
        "workflow",
        "protocol"
      ],
      "title": "HandoffKind",
      "type": "string"
    },
    "HandoffTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/HandoffKind"
        },
        "protocol_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Ref"
        }
      },
      "required": [
        "kind"
      ],
      "title": "HandoffTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One-way notification; ends GIDP's responsibility (Section 14.7).",
  "properties": {
    "version": {
      "const": "gidp/0.1",
      "default": "gidp/0.1",
      "title": "Version",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "Handoff",
      "default": "Handoff",
      "title": "Type",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/HandoffTarget"
    },
    "authorized_scope": {
      "items": {
        "$ref": "#/$defs/Authority"
      },
      "title": "Authorized Scope",
      "type": "array"
    },
    "requires_principal_presence": {
      "default": true,
      "title": "Requires Principal Presence",
      "type": "boolean"
    },
    "contingent_on": {
      "items": {
        "type": "string"
      },
      "title": "Contingent On",
      "type": "array"
    }
  },
  "required": [
    "authorized_scope",
    "contingent_on",
    "expires_at",
    "requires_principal_presence",
    "session_id",
    "target",
    "type",
    "version"
  ],
  "title": "Handoff",
  "type": "object",
  "$id": "urn:example:gidp:0.1:Handoff"
}
