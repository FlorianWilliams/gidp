{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "description": "One question about one dimension (Section 14.2).\n\nA claim is a *proposition*, not a dimension: two claims on one key with\ndifferent values are two questions, and a result belongs to the question\nit answers (S-24). ``claim_id`` names the proposition, unique among the\nclaims its sender has sent in the session; an Agent assigns one when the\ncaller does not. ``supersedes`` withdraws earlier claims of the same\nsender, which is the only way a result leaves the session.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/ClaimOperator"
        },
        "value": {
          "title": "Value"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "supersedes": {
          "items": {
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        }
      },
      "required": [
        "key",
        "operator",
        "value",
        "claim_id"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimOperator": {
      "description": "Core claim operators (Section 14.2). Profiles MAY add operators.",
      "enum": [
        "equals",
        "intersects",
        "overlaps",
        "compatible_with"
      ],
      "title": "ClaimOperator",
      "type": "string"
    },
    "ClaimResult": {
      "description": "Per-claim results (Section 15.1).\n\n``CONDITIONALLY_COMPATIBLE`` and ``UNKNOWN`` are non-committal by\ndefinition: they assert neither that the claim holds nor that it fails,\nwhich is what makes the coarsening rule of 15.5 truthful.",
      "enum": [
        "compatible",
        "incompatible",
        "conditionally_compatible",
        "unknown",
        "requires_disclosure",
        "declined"
      ],
      "title": "ClaimResult",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "gidp/0.1",
      "default": "gidp/0.1",
      "title": "Version",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "type": {
      "const": "CompatibilityRequest",
      "default": "CompatibilityRequest",
      "title": "Type",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "allowed_results": {
      "items": {
        "$ref": "#/$defs/ClaimResult"
      },
      "title": "Allowed Results",
      "type": "array"
    }
  },
  "required": [
    "allowed_results",
    "claims",
    "expires_at",
    "request_id",
    "session_id",
    "type",
    "version"
  ],
  "title": "CompatibilityRequest",
  "type": "object",
  "$id": "urn:example:gidp:0.1:CompatibilityRequest"
}
